# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# patchgap pipeline data / harness scratch
# 주의: `/data/raw/`(디렉토리 자체)를 제외하면 git이 내부를 아예 순회하지 않아 아래 negation이
# 무효화된다 — 반드시 `/data/raw/*`(내용물)를 제외해야 `.gitkeep` 재포함이 동작한다.
/data/raw/*
!/data/raw/.gitkeep
/data/cache/
.playwright-mcp/
scratch.md
.mvp-state*.json
/logs/
/data/aggregated/deltas/*.notify.json

# 랜딩 스플래시 월 합성용 원격 아트 캐시(재배포 방지 — 합성 결과만 커밋)
docs/design/tools/.wall-cache/
