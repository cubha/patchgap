{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "npm run build",
  "framework": "nextjs",
  "cleanUrls": true,
  "trailingSlash": true,
  "redirects": [
    {
      "source": "/compare",
      "destination": "/lol/compare/",
      "permanent": false
    },
    {
      "source": "/compare/",
      "destination": "/lol/compare/",
      "permanent": false
    },
    {
      "source": "/methodology",
      "destination": "/lol/methodology/",
      "permanent": false
    },
    {
      "source": "/methodology/",
      "destination": "/lol/methodology/",
      "permanent": false
    },
    {
      "source": "/item/:slug",
      "destination": "/lol/item/:slug/",
      "permanent": false
    },
    {
      "source": "/item/:slug/",
      "destination": "/lol/item/:slug/",
      "permanent": false
    }
  ],
  "headers": [
    {
      "source": "/dd/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/_next/static/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ]
}
