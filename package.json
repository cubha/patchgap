{
  "name": "patchgap",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "pipeline:collect": "tsx scripts/run-collect.ts",
    "pipeline:aggregate": "tsx scripts/run-aggregate.ts",
    "pipeline:ddragon": "tsx scripts/run-ddragon.ts",
    "pipeline:fetch-notes": "tsx scripts/run-fetch-notes.ts",
    "pipeline:match": "tsx scripts/run-match.ts",
    "pipeline:notify": "tsx scripts/run-notify.ts",
    "pipeline:all": "npm run pipeline:collect -- --patch $PATCH_TO && npm run pipeline:timeline -- --patch $PATCH_TO && npm run pipeline:aggregate -- --patch $PATCH_TO && npm run pipeline:ddragon && npm run pipeline:match -- --from $PATCH_FROM --to $PATCH_TO && npm run build",
    "pipeline:timeline": "tsx scripts/run-timeline.ts",
    "pipeline:migrate-notes": "tsx scripts/run-migrate-notes.ts",
    "pipeline:remap-notes": "tsx scripts/run-remap-note-entities.ts",
    "pipeline:tft-collect": "tsx scripts/run-tft-collect.ts",
    "pipeline:cdragon": "tsx scripts/run-cdragon.ts",
    "pipeline:tft-notes": "tsx scripts/run-tft-notes.ts",
    "pipeline:tft-aggregate": "tsx scripts/run-tft-aggregate.ts",
    "pipeline:tft-match": "tsx scripts/run-tft-match.ts",
    "pipeline:tft-determine": "tsx scripts/tft-determine.ts",
    "pipeline:tft-assets": "tsx scripts/run-tft-assets.ts",
    "pipeline:pubg-collect": "tsx scripts/run-pubg-collect.ts",
    "pipeline:pubg-aggregate": "tsx scripts/run-pubg-aggregate.ts",
    "pipeline:pubg-determine": "tsx scripts/pubg-determine.ts",
    "pipeline:pubg-llm": "tsx scripts/run-pubg-llm.ts",
    "pipeline:gamedata-diff": "tsx scripts/run-gamedata-diff.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.124.0",
    "bottleneck": "^2.19.5",
    "cheerio": "^1.2.0",
    "dotenv": "^17.4.2",
    "next": "16.3.4",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "recharts": "^3.10.1",
    "server-only": "^0.0.1",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^22.20.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^6.1.1",
    "eslint": "^9",
    "eslint-config-next": "16.3.4",
    "jsdom": "^29.1.1",
    "tailwindcss": "^4",
    "tsx": "^4.23.13",
    "typescript": "^5",
    "vitest": "^5.0.0"
  }
}
